# ─────────────────────────────────────────────────────────────
# Investaschool Terminal — Environment Variables
# Copy to `.env` and fill in. The app runs locally with only
# DATABASE_URL + Clerk dev keys. OpenAI is OPTIONAL (templated
# fallback is used when OPENAI_API_KEY is absent).
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/investaschool?schema=public"

# Clerk Authentication (https://dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
# Optional: verifies the Clerk webhook that syncs users into Postgres
CLERK_WEBHOOK_SECRET="whsec_xxx"

# Clerk route configuration (defaults shown — usually no change needed)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# OpenAI (OPTIONAL — leave blank to use the deterministic templated generator)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Public app URL (used for PDF links / metadata)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
